{
  "datasets": [
    {
      "name": "gold_yearly_revenue",
      "displayName": "Gold Yearly Revenue",
      "queryLines": [
        "SELECT\n",
        "  year,\n",
        "  total_revenue,\n",
        "  total_orders,\n",
        "  AOV\n",
        "FROM\n",
        "  gold_yearly_revenue"
      ],
      "columns": [
        {
          "displayName": "aov_ratio",
          "description": "Overall average order value across all years",
          "expression": "SUM(total_revenue) * 1.0 / SUM(total_orders)"
        }
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "gold_customer_spend",
      "displayName": "Gold Customer Spend (Top 20)",
      "queryLines": [
        "SELECT\n",
        "  customer_name,\n",
        "  state,\n",
        "  total_orders,\n",
        "  total_spent\n",
        "FROM\n",
        "  gold_customer_spend\n",
        "WHERE\n",
        "  customer_name IS NOT NULL\n",
        "ORDER BY\n",
        "  total_spent DESC\n",
        "LIMIT 20"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "gold_state_sales",
      "displayName": "Gold State Sales",
      "queryLines": [
        "SELECT\n",
        "  state,\n",
        "  total_orders,\n",
        "  total_quantity,\n",
        "  total_revenue\n",
        "FROM\n",
        "  gold_state_sales\n",
        "WHERE\n",
        "  state IS NOT NULL"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "gold_top_products",
      "displayName": "Gold Top Products",
      "queryLines": [
        "SELECT\n",
        "  product_name,\n",
        "  total_quantity,\n",
        "  total_revenue\n",
        "FROM\n",
        "  gold_top_products"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
    {
      "name": "gold_monthly_revenue",
      "displayName": "Gold Monthly Revenue",
      "queryLines": [
        "SELECT\n",
        "  year,\n",
        "  month,\n",
        "  total_orders,\n",
        "  total_revenue,\n",
        "  CONCAT(CAST(year AS STRING), '-', LPAD(CAST(month AS STRING), 2, '0')) AS year_month\n",
        "FROM\n",
        "  gold_monthly_revenue"
      ],
      "catalog": "workspace",
      "schema": "default"
    }
  ],
